# Canonical site URL — used for metadataBase, canonical links, sitemap, OG URLs.
# On Vercel this falls back to VERCEL_PROJECT_PRODUCTION_URL when unset.
NEXT_PUBLIC_SITE_URL=

# ── Booking form delivery (app/contact/actions.ts) ──────────────────────────
# Option A: Resend (https://resend.com). Takes priority when set.
RESEND_API_KEY=
# Sender must be on a domain verified in Resend; defaults to Resend's test sender.
CONTACT_FROM="Ava Michelle Photography <bookings@your-domain.com>"
# Where booking requests land; defaults to BRAND.email in content/site.ts.
CONTACT_TO=

# Option B: Formspree (https://formspree.io) — paste the form endpoint.
FORMSPREE_ENDPOINT=

# With neither set: submissions are logged in development, and in production
# the form shows its designed error state with Ava's email as the fallback.
